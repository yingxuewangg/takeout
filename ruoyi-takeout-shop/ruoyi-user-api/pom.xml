<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>com.ruoyi</groupId>
        <artifactId>ruoyi</artifactId>
        <version>3.9.2</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>ruoyi-user-api</artifactId>

    <description>
        uniapp 小程序端对外接口服务模块：统一 /api 前缀，走小程序独立登录态（token），不走若依后台权限体系
    </description>

    <dependencies>

        <!-- Web MVC（/api 拦截器、Controller 需要） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 通用工具（含 Redis 缓存、文件上传工具等） -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-common</artifactId>
        </dependency>

        <!-- 商家管理端业务模块：复用共用业务表（biz_order/biz_goods 等）的实体与 Mapper（数据访问层归属约定见 merchant.mapper 包说明） -->
        <dependency>
            <groupId>com.ruoyi</groupId>
            <artifactId>ruoyi-merchant</artifactId>
        </dependency>

        <!-- RocketMQ：下单超时关单延迟消息、支付成功事件的生产者与消费者 -->
        <dependency>
            <groupId>org.apache.rocketmq</groupId>
            <artifactId>rocketmq-spring-boot-starter</artifactId>
        </dependency>

        <!-- ===== 二期 AI 智能问答（RAG） ===== -->
        <!-- OpenAI 兼容协议 starter：Chat 模型（千问/DeepSeek/第三方兼容接口）+ Embedding 模型统一由此接入 -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
        <!-- Redis 向量库（RedisVectorStore，需 redis-stack） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-redis</artifactId>
        </dependency>
        <!-- 向量检索增强 Advisor（QuestionAnswerAdvisor，RAG 核心） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-vector-store-advisor</artifactId>
        </dependency>

    </dependencies>

</project>
