{
	"easycom": {
		"autoscan": true,
		"custom": {
			"^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
		}
	},
	"pages": [
		{
			"path": "pages/index/index",
			"style": {
				"navigationBarTitleText": "阿婆干饭社",
				"enablePullDownRefresh": true,
				"onReachBottomDistance": 100
			}
		},
		{
			"path": "pages/goods/detail",
			"style": {
				"navigationBarTitleText": "菜品详情"
			}
		},
		{
			"path": "pages/cart/cart",
			"style": {
				"navigationBarTitleText": "购物车"
			}
		},
		{
			"path": "pages/checkout/checkout",
			"style": {
				"navigationBarTitleText": "确认订单"
			}
		},
		{
			"path": "pages/pay/cashier",
			"style": {
				"navigationBarTitleText": "收银台"
			}
		},
		{
			"path": "pages/pay/result",
			"style": {
				"navigationBarTitleText": "支付成功",
				"navigationBarBackgroundColor": "#FFF6EC",
				"navigationBarTextStyle": "black"
			}
		},
		{
			"path": "pages/order/list",
			"style": {
				"navigationBarTitleText": "我的订单",
				"enablePullDownRefresh": true
			}
		},
		{
			"path": "pages/order/detail",
			"style": {
				"navigationBarTitleText": "订单详情"
			}
		},
		{
			"path": "pages/order/refund",
			"style": {
				"navigationBarTitleText": "申请退款"
			}
		},
		{
			"path": "pages/goods/comments",
			"style": {
				"navigationBarTitleText": "商品留言"
			}
		},
		{
			"path": "pages/shop/info",
			"style": {
				"navigationBarTitleText": "商家信息"
			}
		},
		{
			"path": "pages/ai/chat",
			"style": {
				"navigationBarTitleText": "问问阿婆",
				"navigationBarBackgroundColor": "#FF7043",
				"navigationBarTextStyle": "white"
			}
		},
		{
			"path": "pages/address/list",
			"style": {
				"navigationBarTitleText": "我的地址"
			}
		},
		{
			"path": "pages/favorite/list",
			"style": {
				"navigationBarTitleText": "我的收藏"
			}
		}
	],
	"globalStyle": {
		"navigationBarTextStyle": "white",
		"navigationBarTitleText": "阿婆干饭社",
		"navigationBarBackgroundColor": "#FF7043",
		"backgroundColor": "#FFF6EC"
	},
	"uniIdRouter": {}
}
